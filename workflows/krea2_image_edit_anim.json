   "title": "Enable for two-image edits",
   "properties": {
    "Node name for S&R": "Note"
   },
   "widgets_values": [
    "OPTIONAL REFERENCE IMAGE - extra identity, person, style, or visual guidance. Leave it empty for ordinary single-image edits. In two-image edits, the required source remains image 1 and this reference is image 2."
   ],
   "color": "#432",
